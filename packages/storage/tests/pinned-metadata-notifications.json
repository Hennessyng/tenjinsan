{
  "status": {
    "method": "thread/status/changed",
    "params": { "threadId": "owned-thread", "status": { "type": "idle" } }
  },
  "queue": { "method": "thread/queue/changed", "params": { "threadId": "owned-thread" } },
  "settings": {
    "method": "thread/settings/updated",
    "params": {
      "threadId": "owned-thread",
      "threadSettings": {
