        "collaborationMode": {
          "mode": "default",
          "settings": {
            "model": "synthetic-model",
            "developer_instructions": "PRIVATE_PAYLOAD_SENTINEL"
          }
        },
        "cwd": "/tmp/synthetic-owned",
        "model": "synthetic-model",
        "modelProvider": "openai",
        "sandboxPolicy": { "type": "readOnly", "networkAccess": false },
        "effort": "medium"
      }
    }
  }
}
